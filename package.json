{
  "name": "musclequest.app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Website for the MuscleQuest workout tracker app",
  "author": "Joseph Bouqdib",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "sync-content": "tsx scripts/sync-content.ts",
    "check-links": "node scripts/check-links.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
