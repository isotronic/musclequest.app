---
interface Props { title: string; intro?: string; as?: "h1" | "h2"; align?: "center" | "left" }
const { title, intro, as: Tag = "h2", align = "center" } = Astro.props;
---
<div class:list={["mb-12 max-w-2xl", align === "center" && "mx-auto text-center"]}>
  <Tag class="text-3xl font-bold tracking-tight text-balance md:text-4xl">{title}</Tag>
  {intro && <p class="mt-4 text-lg text-muted text-pretty">{intro}</p>}
</div>
