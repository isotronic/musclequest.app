---
import RequestAccessForm from "./RequestAccessForm.astro";
import type { CoachContent } from "../../content/coach/types";
import type { Locale } from "../../i18n/ui";
interface Props { early: CoachContent["early"]; form: CoachContent["form"]; config: CoachContent["config"]; locale: Locale }
const { early, form, config, locale } = Astro.props;
---
<section id="request" class="px-4 py-20 sm:px-6 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 rounded-3xl border-2 border-accent/70 bg-surface px-6 py-10 sm:px-10 md:p-14 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-balance md:text-4xl">{early.title}</h2>
      <p class="mt-4 text-lg text-muted text-pretty">{early.text}</p>
      <ul class="mt-6 space-y-3">
        {early.bullets.map((b) => (
          <li class="flex gap-3"><svg aria-hidden="true" viewBox="0 0 20 20" class="mt-1 size-5 shrink-0 text-accent" fill="currentColor"><path d="M8 13.6 4.4 10l-1.4 1.4L8 16.4l9-9L15.6 6z" /></svg><span>{b}</span></li>
        ))}
      </ul>
    </div>
    <RequestAccessForm content={form} config={config} locale={locale} />
  </div>
</section>
