---
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import type { CoachContent } from "../../content/coach/types";
interface Props { content: CoachContent["how"] }
const { content } = Astro.props;
---
<Section id="how" tone="surface">
  <SectionHeading title={content.title} intro={content.intro} />
  <ol class="grid gap-6 lg:grid-cols-3">
    {content.steps.map((s, i) => (
      <li class="reveal rounded-2xl border border-surface-2 bg-bg p-6 md:p-8">
        <span aria-hidden="true" class="grid size-10 place-items-center rounded-full bg-accent/15 text-lg font-bold text-accent">{i + 1}</span>
        <h3 class="mt-5 text-xl font-bold tracking-tight">{s.title}</h3>
        <p class="mt-3 text-muted text-pretty">{s.text}</p>
      </li>
    ))}
  </ol>
</Section>
