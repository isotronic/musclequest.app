---
import { playUrl } from "../../lib/seo";
import type { CoachContent } from "../../content/coach/types";
import type { Locale } from "../../i18n/ui";
// Markup only: src/lib/requestForm.ts validates, sends and swaps in the thank-you. The Turnstile widget is
// rendered explicitly by that module (tokens are single-use, so it resets the widget by id after each try).
interface Props { content: CoachContent["form"]; config: CoachContent["config"]; locale: Locale }
const { content, config, locale } = Astro.props;
const { labels, errors } = content;
const groups = [
  { name: "coachingSetting", legend: labels.coachingSetting, options: labels.options.coachingSetting },
  { name: "clientCount", legend: labels.clientCount, options: labels.options.clientCount },
  { name: "clientPhones", legend: labels.clientPhones, options: labels.options.clientPhones },
] as const;
// The thank-you's first sentence ("Thanks, {name}.") is its heading, the rest the paragraph under it.
const split = content.thanks.indexOf(". ");
const thanksTitle = split === -1 ? content.thanks : content.thanks.slice(0, split + 1);
const thanksText = split === -1 ? "" : content.thanks.slice(split + 2);
const field = "mt-2 block w-full rounded-lg border border-muted bg-bg px-3 py-2.5 text-text placeholder:text-muted aria-[invalid=true]:border-danger";
const errorLine = "mt-2 border-l-2 border-danger pl-2 text-sm text-text";
---
<div>
  <form id="request-form" data-api={config.apiUrl} data-locale={locale} data-thanks-play={playUrl("coach")}
    data-messages={JSON.stringify({ ...errors, sending: content.sending })} novalidate aria-labelledby="rf-title">
    <h3 id="rf-title" class="text-2xl font-bold tracking-tight">{content.title}</h3>

    <div class="mt-6">
      <label for="rf-name" class="block font-medium">{labels.name}</label>
      <input id="rf-name" name="name" type="text" autocomplete="name" required aria-describedby="rf-name-error" class={field} />
      <p id="rf-name-error" class={errorLine} hidden></p>
    </div>

    <div class="mt-5">
      <label for="rf-email" class="block font-medium">{labels.email}</label>
      <input id="rf-email" name="email" type="email" autocomplete="email" spellcheck="false" required aria-describedby="rf-email-error" class={field} />
      <p id="rf-email-error" class={errorLine} hidden></p>
    </div>

    {groups.map((g) => (
      <fieldset class="mt-5" aria-describedby={`rf-${g.name}-error`}>
        <legend class="font-medium">{g.legend}</legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
          {Object.entries(g.options).map(([value, label]) => (
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-muted bg-bg px-3 py-2.5 hover:border-text has-[:checked]:border-accent">
              <input type="radio" name={g.name} value={value} id={`rf-${g.name}-${value}`} required aria-describedby={`rf-${g.name}-error`} class="size-4 shrink-0 accent-accent" />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <p id={`rf-${g.name}-error`} class={errorLine} hidden></p>
      </fieldset>
    ))}

    <div class="mt-5">
      <label for="rf-message" class="block font-medium">{labels.message} <span class="font-normal text-muted">({labels.optional})</span></label>
      <textarea id="rf-message" name="message" rows="4" aria-describedby="rf-message-error" class:list={[field, "resize-y"]}></textarea>
      <p id="rf-message-error" class={errorLine} hidden></p>
    </div>

    <input type="hidden" name="source" id="rf-source" value="" />
    <input type="hidden" name="locale" value={locale} />

    <div class="mt-6 min-h-[65px]" role="group" aria-label={labels.turnstile}>
      <div id="rf-turnstile" data-sitekey={config.turnstileSiteKey} data-action="access-request" data-theme="dark"></div>
    </div>

    <p id="rf-form-error" role="alert" class={errorLine} hidden></p>

    <button type="submit" id="rf-submit" disabled
      class="mt-6 w-full rounded-full bg-accent px-6 py-3 font-semibold text-bg hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-accent sm:w-auto">{content.submit}</button>
    <p class="mt-4 text-sm text-muted">{content.note.text} <a href="/privacy-policy/" class="underline hover:text-accent">{content.note.privacyLink}</a></p>
    <noscript><p class={errorLine}>{content.noScript}</p></noscript>
  </form>

  <div id="rf-thanks" hidden>
    <h3 id="rf-thanks-title" tabindex="-1" data-template={thanksTitle} class="text-2xl font-bold tracking-tight">{thanksTitle}</h3>
    {thanksText && <p class="mt-4 text-lg text-muted text-pretty">{thanksText}</p>}
    <a href={playUrl("coach")} rel="noopener" class="mt-6 inline-block rounded-full bg-accent px-6 py-3 font-semibold text-bg hover:bg-accent-hover">{content.thanksPlay}</a>
  </div>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer is:inline></script>
