---
// Readable legal-text styling, no typography plugin
---
<div class="prose-mq mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20"><slot /></div>

<style is:global>
  @reference "../styles/global.css";
  .prose-mq h1 { @apply text-4xl font-bold tracking-tight; }
  .prose-mq h2 { @apply mt-12 scroll-mt-24 text-2xl font-bold; }
  .prose-mq h3 { @apply mt-8 text-xl font-semibold; }
  .prose-mq p, .prose-mq ul { @apply mt-4 leading-relaxed text-text/90; }
  .prose-mq ul { @apply list-disc space-y-2 pl-6 marker:text-accent; }
  .prose-mq a { @apply text-accent underline underline-offset-2 hover:text-accent-hover; }
  .prose-mq strong { @apply font-semibold text-text; }
</style>
