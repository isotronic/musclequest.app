---
import { LOCALE_NAMES, SITE_LOCALES, htmlLang, localePath, t, type Locale } from "../i18n/ui";
import { AUTHOR_URL, INSTAGRAM_URL, SUPPORT_EMAIL, playUrl } from "../lib/seo";
interface Props { locale: Locale; path: string; translated: boolean }
const { locale, path, translated } = Astro.props;
// An English-only page switches to the other language's home page.
const languages = SITE_LOCALES.map((l) => ({ locale: l, name: LOCALE_NAMES[l], href: localePath(l, translated ? path : "/") }));
const year = new Date().getFullYear();
const cols = [
  { title: t(locale, "footer.product"), links: [
    { href: localePath(locale, "/#features"), label: t(locale, "nav.features") },
    { href: localePath(locale, "/help/"), label: t(locale, "nav.help") },
    { href: localePath(locale, "/changelog/"), label: t(locale, "nav.changelog") },
    { href: playUrl("footer"), label: "Google Play" },
  ]},
  { title: t(locale, "footer.legal"), links: [
    { href: "/privacy-policy/", label: t(locale, "footer.privacy") },
    { href: localePath(locale, "/delete-account/"), label: t(locale, "footer.deleteAccount") },
  ]},
  { title: t(locale, "footer.contact"), links: [
    { href: `mailto:${SUPPORT_EMAIL}`, label: SUPPORT_EMAIL },
    { href: INSTAGRAM_URL, label: t(locale, "footer.instagram") },
  ]},
];
---
<footer id="contact" class="border-t border-surface-2/60 bg-bg px-4 py-14 sm:px-6">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-4">
    <div>
      <p class="text-lg font-bold text-accent">MuscleQuest</p>
      <p class="mt-2 text-sm text-muted">© {year} · {t(locale, "footer.madeBy")} <a href={AUTHOR_URL} class="underline hover:text-accent">Joseph Bouqdib</a></p>
      <nav aria-labelledby="footer-language" class="mt-6">
        <h2 id="footer-language" class="text-sm font-semibold text-text">{t(locale, "footer.language")}</h2>
        <ul class="mt-3 flex gap-4 text-sm">
          {languages.map((l) => (
            <li>
              {l.locale === locale
                ? <span aria-current="page" class="font-semibold text-accent" lang={htmlLang(l.locale)}>{l.name}</span>
                : <a href={l.href} hreflang={htmlLang(l.locale)} lang={htmlLang(l.locale)} class="text-muted hover:text-accent">{l.name}</a>}
            </li>
          ))}
        </ul>
      </nav>
    </div>
    {cols.map((c) => (
      <div>
        <h2 class="text-sm font-semibold text-text">{c.title}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {c.links.map((l) => <li><a href={l.href} class="text-muted hover:text-accent">{l.label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
</footer>
