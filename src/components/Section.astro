---
interface Props { id?: string; class?: string; tone?: "bg" | "surface" }
const { id, class: cls = "", tone = "bg" } = Astro.props;
---
<section id={id} class:list={[tone === "surface" ? "bg-surface" : "bg-bg", "px-4 py-20 sm:px-6 md:py-28", cls]}>
  <div class="mx-auto max-w-6xl"><slot /></div>
</section>
