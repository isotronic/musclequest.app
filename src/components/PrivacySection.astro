---
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";
import type { HomeContent } from "../content/home/types";
const { content } = Astro.props as { content: HomeContent["privacy"] };
---
<Section id="privacy">
  <SectionHeading title={content.title} intro={content.intro} />
  <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {content.items.map((i) => (
      <li class="reveal border-l-2 border-accent pl-5">
        <h3 class="font-semibold">{i.title}</h3>
        <p class="mt-1 text-muted">{i.text}</p>
      </li>
    ))}
  </ul>
</Section>
