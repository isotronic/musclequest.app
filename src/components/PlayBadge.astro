---
import { Image } from "astro:assets";
import badge from "../assets/google-play-badge.png";
import { playUrl, type Placement } from "../lib/seo";
import { t, type Locale } from "../i18n/ui";
interface Props { placement: Placement; locale?: Locale; class?: string }
const { placement, locale = "en", class: cls = "" } = Astro.props;
---
<a href={playUrl(placement)} class:list={["inline-block rounded-lg", cls]} rel="noopener">
  <Image src={badge} alt={t(locale, "play.badgeAlt")} height={72} class="-m-3 h-[72px] w-auto" loading="eager" />
</a>
